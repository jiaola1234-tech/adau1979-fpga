# ============================================================
# ADAU1979 FPGA 板级硬件工程 —— Git 忽略规则
#
# 原则：本仓库完整保存设计资产，包括 Altium Designer 的
#       History 版本快照、预览图与工程输出。
#       仅排除操作系统与编辑器产生的无关垃圾文件。
#       原始文件不会被删除，仅是 git 不跟踪。
# ============================================================

# ---------- 操作系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.vs/
.vscode/
.idea/
*.swp
*~

# ---------- 编辑器临时与锁文件 ----------
~$*
*.tmp
*.~lock*
# Altium 打开工程时生成的临时锁目录
__pycache__/
*.py[cod]

# ---------- Python 虚拟环境（辅助脚本用） ----------
.venv/
venv/
.pytest_cache/

# ---------- 凭据与本地文件 ----------
.env
.env.*
*.pem
*.key
